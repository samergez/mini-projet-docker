WORKER_MODE=dry-run
WORKER_INTERVAL_SECONDS=60
WORKER_BATCH_SIZE=1
WORKER_SPEED_MULTIPLIER=60

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your.sandbox.account@gmail.com
SMTP_APP_PASSWORD=your_gmail_app_password
SANDBOX_TO_EMAIL=your.sandbox.account@gmail.com
MAIL_FROM_NAME=Sandbox Mail Worker

GOOGLE_OAUTH_CLIENT_SECRET=credentials/client_secret.json
GOOGLE_TOKEN_PATH=credentials/token.json
